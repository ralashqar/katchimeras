    "device:ios:list": "eas device:list",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:dev:clear": "eas build --platform ios --profile development --clear-cache",
    "build:ios:dev:resign": "eas build:resign --platform ios --source-profile development --target-profile development",
