    "test:world-board-lab": "tsx --test tests/world-board-lab.test.ts",
    "test:roles": "tsx --test tests/katchimera-role-framework.test.ts tests/katchimera-identity.test.ts tests/katchimera-wardrobe.test.ts tests/companion-bond.test.ts tests/companion-content.test.ts tests/companion-conversation-v2.test.ts tests/companion-journal-handoff.test.ts tests/companion-interaction.test.ts tests/companion-journey.test.ts tests/companion-quick-goals.test.ts tests/companion-achievements.test.ts tests/semantic-quest-verification.test.ts tests/journal-hatch-affinities.test.ts",
