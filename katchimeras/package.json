    "build:ios:preview": "eas build --platform ios --profile preview",
    "update:development": "eas update --channel development && npx sentry-expo-upload-sourcemaps dist",
    "update:preview": "eas update --channel preview && npx sentry-expo-upload-sourcemaps dist",
    "update:production": "eas update --channel production && npx sentry-expo-upload-sourcemaps dist",
    "eas:inspect:archive": "eas build:inspect --platform ios --stage archive --profile development --output dist/eas-archive --force",
    "eas:builds": "eas build:list"
