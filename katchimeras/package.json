{
  "name": "katchimeras",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "verify": "node ./scripts/verify-all.cjs",
    "verify:foundation-native": "node ./scripts/verify-foundation-native.cjs",
    "test:kingdom": "tsx --test tests/kingdom-rendering.test.ts tests/katchimera-roster.test.ts",
    "test:game-hub": "tsx --test tests/game-hub.test.ts && node scripts/verify-companion-quest-repair.cjs",
    "test:lifecycle": "tsx --test tests/app-lifecycle-performance.test.ts",
    "test:today-exploration": "tsx --test tests/today-exploration-gesture.test.ts tests/today-exploration-backgrounds.test.ts tests/companion-home-layout.test.ts",
    "test:today-window": "tsx --test tests/today-tile-window.test.ts",
    "test:today-growth": "tsx --test tests/today-growth.test.ts tests/home-loop-presentation.test.ts tests/today-hatch-presentation.test.ts tests/today-energy-loop-performance.test.ts tests/home-storage-partition.test.ts",
    "test:world-atlas": "tsx --test tests/world-tile-atlas.test.ts",
    "test:roles": "tsx --test tests/katchimera-role-framework.test.ts tests/katchimera-identity.test.ts tests/katchimera-wardrobe.test.ts tests/companion-bond.test.ts tests/companion-content.test.ts tests/companion-interaction.test.ts tests/companion-journey.test.ts tests/companion-quick-goals.test.ts tests/companion-achievements.test.ts tests/semantic-quest-verification.test.ts tests/journal-hatch-affinities.test.ts",
    "check": "npm run typecheck && npm run lint && npm run verify && npm run test:kingdom && npm run test:game-hub && npm run test:lifecycle && npm run test:today-exploration && npm run test:today-window && npm run test:today-growth && npm run test:roles",
    "world:editor": "node tools/world-editor/server.cjs",
    "world:editor:check": "node tools/world-editor/check.cjs",
    "world:creatures:lod": "python scripts/generate-creature-lod.py",
    "world:creatures:lod:report": "python scripts/generate-creature-lod.py --report-only",
    "world:hatchlings:lod": "python scripts/generate-hatchling-lod.py",
    "world:hatchlings:lod:report": "python scripts/generate-hatchling-lod.py --report-only",
    "world:objects:lod": "python scripts/generate-world-object-lod.py",
    "world:objects:lod:report": "python scripts/generate-world-object-lod.py --report-only",
    "world:sky": "python scripts/generate-kingdom-sky-assets.py",
    "art:evolution-grid": "python scripts/generate-evolution-grid.py",
    "art:today-scenes": "python scripts/generate-today-full-spread.py",
    "art:achievement-icons": "python scripts/process-achievement-icon-sheet.py",
    "art:achievement-generate": "python scripts/generate-achievement-trophy-sheet.py",
    "art:today-scenes:validate": "python scripts/generate-today-full-spread.py validate",
    "art:exploration-backgrounds": "python scripts/generate-exploration-background.py",
    "art:exploration-backgrounds:validate": "python scripts/generate-exploration-background.py validate",
    "art:today-backgrounds": "python scripts/generate-today-atmosphere-backgrounds.py",
    "art:today-backgrounds:validate": "python scripts/generate-today-atmosphere-backgrounds.py validate",
    "assets:audit": "node scripts/audit-eas-assets.cjs",
    "assets:audit:check": "node scripts/audit-eas-assets.cjs --check",
    "assets:audit:write": "node scripts/audit-eas-assets.cjs --write",
    "local-env:guide": "python scripts/generate-local-environment-guide.py",
    "local-env:placeholders": "python scripts/generate-local-environment-placeholders.py",
    "eas:login": "eas login",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:dev:clear": "eas build --platform ios --profile development --clear-cache",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "update:development": "eas update --channel development",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "eas:inspect:archive": "eas build:inspect --platform ios --stage archive --profile development --output dist/eas-archive --force",
    "eas:builds": "eas build:list"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@rive-app/react-native": "^0.4.1",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.102.1",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-calendar": "~15.0.8",
    "expo-camera": "^55.0.15",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-mesh-gradient": "~0.4.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eas-cli": "^18.5.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "express": "^5.2.1",
    "tsx": "^4.23.0",
    "typescript": "~5.9.2",
    "vite": "^6.4.3"
  },
  "private": true
}
