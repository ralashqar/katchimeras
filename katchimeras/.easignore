# EAS is launched from this Expo project directory. Keep this file here so
# both local and GitHub Actions builds apply the same archive exclusions.

# EAS defaults
.git/
node_modules/

# Repository-local caches and generated output
__pycache__/
.claude/
.expo/
dist/
web-build/
expo-env.d.ts
.tmp/
tmp/

# Generated native projects (EAS runs Expo prebuild)
ios/
android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local logs, credentials, and editor state
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
.vscode/
.expo-*.log
.expo-*.err.log
app-example/

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
supabase/.env.keys
supabase/.env.local
supabase/.env.*.local

# Development-only material not used during native compilation
design/
docs/
tests/
tools/
artifacts/

