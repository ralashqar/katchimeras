        if (props.ftueBondSpotlightActive || props.ftueDayOneActionActive) return;
        const requestId = `${mossproutJourney?.id ?? 'mossprout'}:${definitionId}`;
        if (autoOpenedJourneyProfileRef.current === requestId) return;
