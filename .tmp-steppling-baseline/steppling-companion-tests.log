        setRewardSourceVersion((current) => current + 1);
      }, []);
      const requestStoryReward = useCallback((source: GoalTaskSourceRect, onArrive: () => void, receipt?: CompanionBondAwardReceipt) => {
        pendingRewardSourceRef.current = source;
